{
  "plugins": [
    "import",
    "@typescript-eslint",
    "eslint-plugin-tsdoc",
    "eslint-plugin-unused-imports",
    "prettier"
  ],
  "settings": {
    "import/resolver": {
      "typescript": {
        "project": "./tsconfig.json",
        "alwaysTryTypes": true
      },
      "node": {
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx"
        ],
        "moduleDirectory": [
          "node_modules",
          "src/"
        ]
      }
    },
    "import/parsers": {
      "@typescript-eslint/parser": [
        ".ts",
        ".tsx"
      ]
    },
    "import/extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ]
  },
  "env": {
    "browser": true
  },
  "ignorePatterns": [
    ".eslintrc",
    "build"
  ],
  "extends": [
    "airbnb",
    "airbnb/hooks",
    "prettier",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "project": "./tsconfig.json",
    "ecmaFeatures": {
      "jsx": true
    },
    "sourceType": "module"
  },
  "rules": {
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "": "never",
        "tsx": "never",
        "ts": "never",
        "js": "never"
      }
    ],
    "@typescript-eslint/no-empty-function": "off",
    "consistent-return": "off",
    "react/no-array-index-key": "off",
    "no-restricted-syntax": "off",
    "guard-for-in": "off",
    "@typescript-eslint/ban-ts-comment": "off",
    "no-param-reassign": "off",
    "prefer-destructuring": ["warn", {
      "array": false,
      "object": false
    }],
    "react/destructuring-assignment": "off",
    "react/prop-types": "off",
    "react/jsx-props-no-spreading": "off",
    "react/no-unused-prop-types": "off",
    "react-hooks/rules-of-hooks": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "no-nested-ternary": "warn",
    "react/function-component-definition": "off",
    "no-multiple-empty-lines": [
      "error",
      {"max":  1}
    ],
    "react/jsx-filename-extension": [
      2,
      {
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx"
        ]
      }
    ],
    "import/prefer-default-export": "off",
    "import/no-cycle": "off",
    "import/no-unresolved": "error",
    "import/no-internal-modules": "off",
    "import/order": [
      "warn",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index"
        ],
        "pathGroups": [
          {
            "pattern": "react",
            "group": "external",
            "position": "before"
          },
          {
            "pattern": "@mui/**",
            "group": "external",
            "position": "after"
          },
          {
            "pattern": "pages/**",
            "group": "internal",
            "position": "before"
          },
          {
            "pattern": "features/**",
            "group": "internal",
            "position": "before"
          },
          {
            "pattern": "widgets/**",
            "group": "internal",
            "position": "before"
          },
          {
            "pattern": "shared/**",
            "group": "internal",
            "position": "before"
          },
          {
            "pattern": "entities/**",
            "group": "internal",
            "position": "before"
          }
        ],
        "pathGroupsExcludedImportTypes": [
          "builtin"
        ],
        "newlines-between": "always",
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": false
        },
        "warnOnUnassignedImports": true
      }
    ],
    "no-underscore-dangle": "off",
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "shared/*/**",
              "entities/*/**",
              "features/*/**",
              "widgets/*/**",
              "pages/*/**",
              "app/*/**"
            ],
            "message": "Direct access to the internal parts of the module is prohibited"
          },
          {
            "group": [
              "../**/shared",
              "../**/entities",
              "../**/features",
              "../**/widgets",
              "../**/pages",
              "../**/app"
            ],
            "message": "Prefer absolute imports instead of relatives"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "*.ts",
        ".*.ts",
        "./**/*.ts",
        "./**/.*.ts",
        "*.tsx",
        ".*.tsx",
        "./**/*.tsx",
        "./**/.*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module",
        "project": true
      },
      "plugins": [
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint"
      ],
      "extends": [
        "plugin:eslint-plugin-import/typescript"
      ],
      "rules": {
        "react/require-default-props": "off",
        "@typescript-eslint/no-throw-literal": "off",
        "@typescript-eslint/naming-convention": [
          "warn",
          {
            "selector": "variable",
            "format": [
              "camelCase",
              "PascalCase",
              "UPPER_CASE"
            ],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "allow"
          },
          {
            "selector": "variable",
            "modifiers": [
              "destructured"
            ],
            "format": [
              "camelCase",
              "PascalCase",
              "snake_case",
              "UPPER_CASE"
            ],
            "leadingUnderscore": "allow"
          }
        ],
        "import/extensions": [
          "error",
          "ignorePackages",
          {
            "": "never",
            "tsx": "never",
            "ts": "never",
            "js": "never"
          }
        ],
        "import/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": [
              "**/__tests__/**",
              "**/__mocks__/**",
              "**/*.test.ts",
              "**/*.test.tsx",
              "**/*.spec.ts",
              "src/shared/lib/test/setup.ts",
              "src/shared/lib/test/test.lib.tsx"
            ]
          }
        ]
      }
    }
  ]
}
