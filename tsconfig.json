{
  "compilerOptions": {
    "rootDir": ".",
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react",
    "baseUrl": "src",
    "paths": {
      "app": [
        "./app"
      ],
      "pages": [
        "./pages"
      ],
      "widgets": [
        "./widgets"
      ],
      "features": [
        "./features"
      ],
      "entities": [
        "./entities"
      ],
      "shared": [
        "./shared"
      ],
      "public": [
        "./../public"
      ]
    }
  },
  "strict": true,
  "noUnusedLocals": true,
  "noUnusedParameters": true,
  "noFallthroughCasesInSwitch": true,
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ],

}
