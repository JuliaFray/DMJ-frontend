{
  "compilerOptions": {
    "rootDir": ".",
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "skipDefaultLibCheck": true,
    "strictPropertyInitialization": false,
    "downlevelIteration": true,
    "importHelpers": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "baseUrl": "src",
    "paths": {
      "app": [
        "./app"
      ],
      "pages": [
        "./pages/*"
      ],
      "widgets/*": [
        "./widgets/*"
      ],
      "features/*": [
        "./features/*"
      ],
      "entities/*": [
        "./entities/*"
      ],
      "shared/*": [
        "./shared/*",
      ],
      "public": [
        "./../public"
      ]
    }
  },
  "strict": true,
  "noUnusedLocals": true,
  "noUnusedParameters": true,
  "exclude": [
    "node_modules"
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
